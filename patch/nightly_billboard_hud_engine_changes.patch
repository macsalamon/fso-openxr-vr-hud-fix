+// ---------------------------------------------------------------------------------------------------------------------
+// VR target brackets (see hudvr.h)
+// ---------------------------------------------------------------------------------------------------------------------
+namespace {
+
+SCP_vector<vr_overlay_bracket> Overlay_queue;
+int Label_bitmap = -1;
+
+// "VRHudBillboardBrackets=0" in the [Default] section of fs2_open.ini switches the feature off. Read once.
+bool overlay_feature_on()
+{
+	static int on = -1;
+
+	if (on < 0) {
+		on = 1;
+
+		const char* configured = os_config_read_string("Default", "VRHudBillboardBrackets", nullptr);
+		if (configured != nullptr && atoi(configured) == 0) {
+			on = 0;
+		}
+
+		mprintf(("VR HUD: billboard target brackets are %s\n", on ? "on" : "off"));
+	}
+
+	return on != 0;
+}
+
+// Renders the name text of every queued bracket into the label layer, one slot per bracket
+void overlay_render_labels()
+{
+	Label_bitmap = -1;
+
+	bool any_text = false;
+	for (const auto& e : Overlay_queue) {
+		any_text = any_text || !e.name.empty() || !e.cls.empty() || !e.dist.empty();
+	}
+
+	if (!any_text) {
+		return;
+	}
+
+	Label_bitmap = gr_screen_label_layer_begin();
+	if (Label_bitmap < 0) {
+		return;
+	}
+
+	const int previous_font = font::get_current_fontnum();
+
+	gr_reset_clip();
+	gr_reset_screen_scale();
+
+	for (size_t i = 0; i < Overlay_queue.size() && i < static_cast<size_t>(VR_LABEL_SLOTS); i++) {
+		auto& e = Overlay_queue[i];
+
+		if (e.font_num >= 0) {
+			font::set_font(e.font_num);
+		}
+		gr_set_color_fast(&e.clr);
+
+		const int line_h = gr_get_font_height();
+		const int slot_top = static_cast<int>(i) * VR_LABEL_SLOT_H;
+
+		int y = slot_top + 2;
+		int widest = 0;
+
+		for (const SCP_string* line : { &e.name, &e.cls, &e.dist }) {
+			if (line->empty() || y + line_h > slot_top + VR_LABEL_SLOT_H) {
+				continue;
+			}
+
+			int w = 0, h = 0;
+			gr_get_string_size(&w, &h, line->c_str());
+			gr_string(2, y, line->c_str(), GR_RESIZE_NONE);
+
+			widest = std::max(widest, w);
+			y += line_h;
+		}
+
+		e.label_slot = static_cast<int>(i);
+		e.label_w = std::min(widest + 4, gr_screen.max_w);
+		e.label_h = y - slot_top;
+	}
+
+	font::set_font(previous_font);
+
+	gr_screen_layer_end();
+}
+
+// Draws the queued brackets for the eye being rendered. Called with the eye's view, right after the panel.
+void overlay_draw(const fov_t& eye_fov)
+{
+	if (Overlay_queue.empty()) {
+		return;
+	}
+
+	// The panel's frustum (see hud_vr_draw_panel()): how many HUD pixels fit into one unit of tangent at its centre
+	const float tan_y = tanf(PANEL_FOV * PROJ_FOV_FACTOR * 0.5f);
+	const float tan_x = tan_y * i2fl(gr_screen.max_w) / (i2fl(gr_screen.max_h) * gr_screen.aspect);
+	const float fx = i2fl(gr_screen.max_w) * 0.5f / tan_x;
+	const float fy = i2fl(gr_screen.max_h) * 0.5f / tan_y;
+
+	// where the virtual HUD camera is, relative to the eye
+	vec3d hud_offset;
+	vm_vec_sub(&hud_offset, &Panel_pos, &Eye_pos);
+
+	// sizes in HUD pixels
+	constexpr float THICKNESS = 1.0f;
+	constexpr float PADDING = 5.0f;
+	constexpr float MIN_HALF_SIZE = 18.0f;
+	constexpr float LABEL_GAP = 4.0f;
+
+	struct label_vertex {
+		vec3d pos;
+		float u, v;
+	};
+
+	// A screen layer keeps the rows in the order of the screen's framebuffer, which OpenGL stores bottom up
+	const float v_screen_top = gr_screen.mode == GraphicsAPI::OpenGL ? 1.0f : 0.0f;
+	const float v_screen_bottom = 1.0f - v_screen_top;
+	auto layer_v = [&](float y) { return v_screen_top + (v_screen_bottom - v_screen_top) * (y / i2fl(gr_screen.max_h)); };
+	auto layer_u = [&](float x) { return x / i2fl(gr_screen.max_w); };
+
+	gr_reset_clip();
+	gr_set_proj_matrix(eye_fov * PROJ_FOV_FACTOR, gr_screen.clip_aspect, PANEL_DISTANCE * 0.1f, PANEL_DISTANCE * 10.0f);
+	gr_set_view_matrix(&vmd_zero_vector, &Eye_orient);
+
+	for (const auto& e : Overlay_queue) {
+		// direction of the target as seen from the virtual HUD camera
+		vec3d dir;
+		vm_vec_sub(&dir, &e.pos, &Panel_pos);
+		if (vm_vec_mag(&dir) < 0.01f) {
+			continue;
+		}
+		vm_vec_normalize(&dir);
+
+		// the frame's axes: the ship's right and up axes, projected onto the plane the frame stands on
+		vec3d right = Panel_orient.vec.rvec;
+		vm_vec_scale_add2(&right, &dir, -vm_vec_dot(&right, &dir));
+		if (vm_vec_mag(&right) < 0.001f) {
+			// looking straight along the ship's right axis: fall back to the up axis
+			right = Panel_orient.vec.uvec;
+			vm_vec_scale_add2(&right, &dir, -vm_vec_dot(&right, &dir));
+		}
+		vm_vec_normalize(&right);
+
+		vec3d up;
+		vm_vec_cross(&up, &dir, &right);
+		if (vm_vec_dot(&up, &Panel_orient.vec.uvec) < 0.0f) {
+			vm_vec_negate(&up);
+		}
+
+		// extent of the bounding box on that plane (tangent units), seen from the virtual HUD camera
+		float a_min = 1e9f, a_max = -1e9f, b_min = 1e9f, b_max = -1e9f;
+		bool clamped = false;
+
+		for (const auto& corner : e.corners) {
+			vec3d v;
+			vm_vec_sub(&v, &corner, &Panel_pos);
+			const float len = vm_vec_mag(&v);
+			const float depth = vm_vec_dot(&v, &dir);
+
+			if (depth <= 0.2f * len) {
+				clamped = true;		// the corner is (almost) beside or behind us: the target is huge and close
+				continue;
+			}
+
+			const float a = vm_vec_dot(&v, &right) / depth;
+			const float b = vm_vec_dot(&v, &up) / depth;
+			a_min = std::min(a_min, a); a_max = std::max(a_max, a);
+			b_min = std::min(b_min, b); b_max = std::max(b_max, b);
+		}
+
+		if (clamped || a_min > a_max) {
+			a_min = b_min = -2.0f;
+			a_max = b_max = 2.0f;
+		}
+
+		// the frame in HUD pixels: centre and half size, with similar padding and minimum size as the HUD frame has
+		const float cx = 0.5f * (a_min + a_max) * fx;
+		const float cy = 0.5f * (b_min + b_max) * fy;
+		const float hw = std::max(0.5f * (a_max - a_min) * fx + PADDING, MIN_HALF_SIZE);
+		const float hh = std::max(0.5f * (b_max - b_min) * fy + PADDING, MIN_HALF_SIZE);
+
+		// HUD pixel (px right, py up, relative to the target direction) -> position relative to the eye
+		auto point = [&](float px, float py) {
+			vec3d p = dir;
+			vm_vec_scale_add2(&p, &right, px / fx);
+			vm_vec_scale_add2(&p, &up, py / fy);
+			vm_vec_scale(&p, PANEL_DISTANCE);
+			vm_vec_add2(&p, &hud_offset);
+			return p;
+		};
+
+		// ---- the frame: corner brackets, 50% of the way along each side
+		SCP_vector<vec3d> tris;
+		tris.reserve(4 * 2 * 6);
+
+		auto rect = [&](float x0, float y0, float x1, float y1) {
+			const vec3d p00 = point(x0, y0), p10 = point(x1, y0), p01 = point(x0, y1), p11 = point(x1, y1);
+			tris.push_back(p00); tris.push_back(p10); tris.push_back(p11);
+			tris.push_back(p00); tris.push_back(p11); tris.push_back(p01);
+		};
+
+		const float arm_x = std::max(hw * 0.5f, THICKNESS * 2.0f);
+		const float arm_y = std::max(hh * 0.5f, THICKNESS * 2.0f);
+
+		for (int sx = -1; sx <= 1; sx += 2) {
+			for (int sy = -1; sy <= 1; sy += 2) {
+				const float ox = cx + sx * hw;
+				const float oy = cy + sy * hh;
+				rect(ox, oy, ox - sx * arm_x, oy - sy * THICKNESS);		// horizontal arm
+				rect(ox, oy, ox - sx * THICKNESS, oy - sy * arm_y);		// vertical arm
+			}
+		}
+
+		{
+			color frame_clr;
+			gr_init_alphacolor(&frame_clr, e.clr.red, e.clr.green, e.clr.blue, 255);
+
+			material mat;
+			material_set_unlit_color(&mat, -1, &frame_clr, true, false);
+
+			vertex_layout layout;
+			layout.add_vertex_component(vertex_format_data::POSITION3, sizeof(vec3d), 0);
+
+			gr_render_primitives_immediate(&mat, PRIM_TYPE_TRIS, &layout, static_cast<int>(tris.size()), tris.data(), tris.size() * sizeof(vec3d));
+		}
+
+		// ---- the label, centred under the frame
+		if (Label_bitmap >= 0 && e.label_slot >= 0 && e.label_w > 0 && e.label_h > 0) {
+			const float lw = static_cast<float>(e.label_w);
+			const float lh = static_cast<float>(e.label_h);
+			const float slot_top = static_cast<float>(e.label_slot * VR_LABEL_SLOT_H);
+
+			const float x0 = cx - lw * 0.5f, x1 = cx + lw * 0.5f;
+			const float y_top = cy - hh - LABEL_GAP, y_bottom = y_top - lh;
+
+			auto vtx = [&](float px, float py, float x, float y) {
+				return label_vertex{ point(px, py), layer_u(x), layer_v(y) };
+			};
+
+			label_vertex verts[4] = {
+				vtx(x0, y_top, 0.0f, slot_top),
+				vtx(x1, y_top, lw, slot_top),
+				vtx(x0, y_bottom, 0.0f, slot_top + lh),
+				vtx(x1, y_bottom, lw, slot_top + lh),
+			};
+
+			vertex_layout layout;
+			layout.add_vertex_component(vertex_format_data::POSITION3, sizeof(label_vertex), offsetof(label_vertex, pos));
+			layout.add_vertex_component(vertex_format_data::TEX_COORD2, sizeof(label_vertex), offsetof(label_vertex, u));
+
+			material mat;
+			material_set_interface(&mat, Label_bitmap, true, 1.0f);
+			mat.set_blend_mode(ALPHA_BLEND_PREMULTIPLIED);
+
+			gr_render_primitives_immediate(&mat, PRIM_TYPE_TRISTRIP, &layout, 4, verts, sizeof(verts));
+		}
+	}
+
+	gr_end_view_matrix();
+	gr_end_proj_matrix();
+}
+
+}
+
+bool vr_overlay_brackets_active()
+{
+	return Panel_drawing && overlay_feature_on();
+}
+
+void vr_overlay_add(vr_overlay_bracket&& bracket)
+{
+	// the same object can be bracketed by more than one gauge entry: keep one frame, with the most complete label
+	for (auto& existing : Overlay_queue) {
+		if (bracket.objnum >= 0 && existing.objnum == bracket.objnum) {
+			if (existing.name.empty() && existing.cls.empty() && existing.dist.empty()) {
+				existing.name = bracket.name;
+				existing.cls = bracket.cls;
+				existing.font_num = bracket.font_num;
+			}
+			if (existing.dist.empty()) {
+				existing.dist = bracket.dist;
+			}
+			return;
+		}
+	}
+
+	Overlay_queue.push_back(std::move(bracket));
+}
