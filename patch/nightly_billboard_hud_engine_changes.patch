+// VR target brackets. While the HUD panel is drawn, the target frame of the engine's bracket gauge is not drawn into it.
+// It is queued here instead and drawn for each eye as a frame that stands on the tangent plane of a sphere around the
+// ship, at the direction of the target: always upright to the ship, never stretched, and not cut off at the edge of the
+// HUD panel. The name text is rendered into a label layer (one slot per bracket) and shown under the frame.
+// "VRHudBillboardBrackets=0" in the [Default] section of fs2_open.ini switches this off.
+constexpr int VR_LABEL_SLOTS = 4;
+constexpr int VR_LABEL_SLOT_H = 96;		// logical pixels, the label layer is as big as the screen
+
+struct vr_overlay_bracket {
+	vec3d corners[8];		// world space corners of the target's bounding box
+	vec3d pos;				// world position of the target
+	color clr;
+	SCP_string name, cls, dist;		// label lines (may be empty)
+	int objnum = -1;		// used to merge duplicates
+	int font_num = -1;
+	int label_slot = -1;	// set by the label pass: where the text is, and how big it is (logical pixels)
+	int label_w = 0;
+	int label_h = 0;
+};
+
+// true if the bracket gauge should queue its brackets instead of drawing them (while the VR HUD panel is drawn)
+bool vr_overlay_brackets_active();
