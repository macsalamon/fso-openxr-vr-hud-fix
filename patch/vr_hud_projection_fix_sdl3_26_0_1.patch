+// VR: the target frame is not drawn into the HUD texture. It is queued, and drawn for each eye at the direction of the
+// target (see vr_overlay_bracket in graphics/matrix.h).
+static void hud_queue_vr_bracket(object* targetp, int font_num, int flags, float distance)
+{
+	vr_overlay_bracket b;
+
+	int modelnum = -1;
+	int submodel_num = -1;
+
+	switch (targetp->type) {
+	case OBJ_SHIP:
+		modelnum = Ship_info[Ships[targetp->instance].ship_info_index].model_num;
+		break;
+	case OBJ_DEBRIS:
+		modelnum = Debris[targetp->instance].model_num;
+		submodel_num = Debris[targetp->instance].submodel_num;
+		break;
+	case OBJ_WEAPON:
+		modelnum = Weapon_info[Weapons[targetp->instance].weapon_info_index].model_num;
+		break;
+	case OBJ_ASTEROID: {
+		int pof = Asteroids[targetp->instance].asteroid_subtype;
+		modelnum = Asteroid_info[Asteroids[targetp->instance].asteroid_type].subtypes[pof].model_number;
+		break;
+	}
+	case OBJ_JUMP_NODE: {
+		auto jnp = jumpnode_get_by_objp(targetp);
+		modelnum = jnp ? jnp->GetModelNumber() : -1;
+		break;
+	}
+	default:
+		return;
+	}
+
+	// bounding box of the target (a small cube if it has no model)
+	vec3d mn = { { { -1.0f, -1.0f, -1.0f } } };
+	vec3d mx = { { { 1.0f, 1.0f, 1.0f } } };
+
+	if (modelnum >= 0) {
+		polymodel* pm = model_get(modelnum);
+		if (pm != nullptr) {
+			if (submodel_num >= 0 && submodel_num < pm->n_models) {
+				mn = pm->submodel[submodel_num].min;
+				mx = pm->submodel[submodel_num].max;
+			} else {
+				mn = pm->mins;
+				mx = pm->maxs;
+			}
+		}
+	}
+
+	for (int i = 0; i < 8; i++) {
+		vec3d local;
+		local.xyz.x = (i & 1) ? mx.xyz.x : mn.xyz.x;
+		local.xyz.y = (i & 2) ? mx.xyz.y : mn.xyz.y;
+		local.xyz.z = (i & 4) ? mx.xyz.z : mn.xyz.z;
+
+		vm_vec_unrotate(&b.corners[i], &local, &targetp->orient);
+		vm_vec_add2(&b.corners[i], &targetp->pos);
+	}
+
+	b.pos = targetp->pos;
+	b.clr = gr_screen.current_color;
+	b.objnum = OBJ_INDEX(targetp);
+	b.font_num = font_num;
+
+	if (flags & TARGET_DISPLAY_DIST) {
+		char text_dist[64];
+		sprintf(text_dist, "%d", static_cast<int>(std::lround(distance * Hud_unit_multiplier)));
+		b.dist = text_dist;
+	}
+
+	if (flags & (TARGET_DISPLAY_NAME | TARGET_DISPLAY_CLASS)) {
+		const char* tinfo_name = nullptr;
+		const char* tinfo_class = nullptr;
+		char temp_name[NAME_LENGTH*2+3];
+		char temp_class[NAME_LENGTH];
+
+		switch (targetp->type) {
+		case OBJ_SHIP:
+			hud_stuff_ship_name(temp_name, &Ships[targetp->instance]);
+			hud_stuff_ship_class(temp_class, &Ships[targetp->instance]);
+			tinfo_name = temp_name;
+			tinfo_class = temp_class;
+
+			// maybe concatenate the callsign
+			if (*temp_name) {
+				char temp_callsign[NAME_LENGTH];
